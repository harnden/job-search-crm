generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CompanyTier {
  Target
  Reach
  Safety
}

enum ApplicationStatus {
  Identified
  Applied
  Screening
  Technical
  Offer
  Rejected
  Ghosted
}

enum ActivityType {
  Email
  Interview
  Call
  Note
}

model Company {
  id           String        @id @default(uuid())
  name         String
  domain       String?
  tier         CompanyTier
  notes        String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  contacts     Contact[]
  applications Application[]

  @@index([tier])
  @@index([domain])
}

model Contact {
  id             String     @id @default(uuid())
  companyId      String
  name           String
  role           String
  email          String?
  phone          String?
  lastContactDate DateTime?
  nextFollowUpDate DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  company        Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  activities     Activity[]

  @@index([companyId])
  @@index([nextFollowUpDate])
}

model Application {
  id           String            @id @default(uuid())
  companyId    String
  jobTitle     String
  jobUrl       String?
  description  String?
  salaryTarget Int?
  status       ApplicationStatus
  discoveredDate DateTime?       @default(now())
  appliedDate  DateTime?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  company      Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  activities   Activity[]

  @@index([companyId])
  @@index([status])
  @@index([discoveredDate])
  @@index([appliedDate])
}

model Activity {
  id            String            @id @default(uuid())
  applicationId String?
  contactId     String?
  type          ActivityType
  notes         String
  timestamp     DateTime          @default(now())
  application   Application?      @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  contact       Contact?           @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@index([contactId])
  @@index([timestamp])
}
